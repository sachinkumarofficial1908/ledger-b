NODE_ENV=production
PORT=5500
MONGO_URI=your_mongodb_connection_string
JWT_ACCESS_SECRET=replace_with_32_plus_char_random_secret
JWT_REFRESH_SECRET=replace_with_a_different_32_plus_char_random_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_SECRET=replace_with_another_32_plus_char_random_secret

CORS_ORIGIN=https://your-frontend-host.example
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace_with_strong_initial_password

# From https://developer.ilovepdf.com/user/projects - used to convert purchase
# order DOCX files to PDF via the iLovePDF API.
ILOVEPDF_PUBLIC_KEY=your_ilovepdf_public_key
ILOVEPDF_SECRET_KEY=your_ilovepdf_secret_key
